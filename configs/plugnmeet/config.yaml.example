# plugNmeet server v2.5.3 — srv-1.gerber.org (192.168.122.10)
client:
  port: 8080
  debug: false
  path: "/opt/plugnmeet/client/dist"
  api_key: "CHANGE_ME"
  secret: "CHANGE_ME"
  token_validity: 10m
  webhook_conf:
    enable: false
    url: ""
    enable_for_per_meeting: false
  prometheus:
    enable: false
    metrics_path: "/metrics"
    username: ""
    password: "CHANGE_ME"
  proxy_conf:
    enabled: true
    proxy_header: "X-Forwarded-For"
    trusted_proxy_ips: [ "127.0.0.0/8", "::1/128" ]
  copyright_conf:
    allow_override: false
    display: true
    text: 'Powered by <a href="https://www.plugnmeet.org" target="_blank">plugNmeet</a>'
room_default_settings:
  max_duration: 0
  max_participants: 0
  max_num_breakout_rooms: 6
  max_preloaded_wb_file_size: 5mb
log_settings:
  log_file: "/opt/plugnmeet/log/plugNmeet.log"
  maxsize: 20
  maxbackups: 4
  maxage: 2
  log_level: "info"
# host — внешний адрес LiveKit: его же получает браузер для подключения к медиасерверу
livekit_info:
  host: "https://192.168.122.10/livekit"
  api_key: "CHANGE_ME"
  secret: "CHANGE_ME"
redis_info:
  host: "127.0.0.1:6379"
  username: ""
  password: "CHANGE_ME"
  db: 0
  default_ttl: 24h
database_info:
  driver_name: mysql
  host: 127.0.0.1
  port: 3306
  username: "plugnmeet"
  password: "CHANGE_ME"
  db: "plugnmeet_v2"
  prefix: "pnm_"
  charset: "utf8mb4"
  loc: "UTC"
  conn_max_lifetime: 4m
  max_open_conns: 10
nats_info:
  nats_urls:
    - "nats://127.0.0.1:4222"
  # адрес NATS WebSocket для браузера (проксируется nginx -> 127.0.0.1:8222)
  nats_ws_urls:
    - "wss://192.168.122.10:443/nats-ws"
  account: PNM
  nkey: "CHANGE_ME"
  auth_callout_issuer_private: "CHANGE_ME"
  auth_callout_xkey_private: "CHANGE_ME"
  num_replicas: 1
  room_stream_name: "pnm-room-stream"
  default_ttl: 24h
  subjects:
    system_api_worker: "sysApiWorker"
    system_js_worker: "sysJsWorker"
    system_core_worker: "sysCoreWorker"
    system_public: "sysPublic"
    system_private: "sysPrivate"
    chat: "chat"
    whiteboard: "whiteboard"
    data_channel: "dataChannel"
  recorder:
    recorder_channel: "recorderChannel"
    recorder_info_kv: "pnm-recorderInfo"
    transcoding_jobs_subject: "pnm-RecorderTranscoderJobs"
upload_file_settings:
  path: "/opt/plugnmeet/upload"
  max_size: 50
  max_size_whiteboard_file: 30
  keep_forever: false
  allowed_types: ["jpg","png","jpeg","svg","pdf","docx","txt","xlsx","pptx","zip","mp4","webm","mp3"]
recorder_info:
  recording_files_path: "/opt/plugnmeet/recording_files"
  token_validity: 30m
  ping_timeout: 8s
  enable_del_recording_backup: true
  del_recording_backup_path: "/opt/plugnmeet/recording_files/del_backup"
  del_recording_backup_duration: 72h
analytics_settings:
  enabled: true
artifacts_settings:
  storage_path: "/opt/plugnmeet/artifacts"
  token_validity: 10m
  enable_del_artifacts_backup: true
  del_artifacts_backup_path: "/opt/plugnmeet/artifacts/trash"
  del_artifacts_backup_duration: 72h
