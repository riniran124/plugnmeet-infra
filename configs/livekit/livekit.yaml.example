# LiveKit для plugNmeet — srv-1.gerber.org
port: 7880
bind_addresses:
  - ""
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: false
  node_ip: 192.168.122.10
keys:
  CHANGE_ME_KEY: CHANGE_ME_SECRET
# события комнат (вход/выход участников и т.п.) отправляются в plugNmeet
webhook:
  api_key: CHANGE_ME_KEY
  urls:
    - "http://127.0.0.1:8080/webhook"
room:
  empty_timeout: 600       # пустая комната живёт 10 минут
  departure_timeout: 300   # после ухода последнего участника — 5 минут (переживает обрыв сети)
  enable_remote_unmute: true
logging:
  level: info
