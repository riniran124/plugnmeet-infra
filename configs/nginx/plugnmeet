# plugNmeet — srv-1.gerber.org
server {
    listen 80;
    server_name srv-1.gerber.org 192.168.122.10 _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name srv-1.gerber.org 192.168.122.10 _;

    ssl_certificate     /etc/ssl/certs/plugnmeet.crt;
    ssl_certificate_key /etc/ssl/private/plugnmeet.key;

    client_max_body_size 64m;

    # LiveKit (медиасервер): API + WebSocket сигнализации
    location /livekit/ {
        proxy_pass http://127.0.0.1:7880/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    # NATS WebSocket (чат, события комнаты)
    location /nats-ws {
        proxy_pass http://127.0.0.1:8222;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }

    # plugNmeet: API + веб-клиент
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}
